<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <servlet>
        <servlet-name>StartSessionServlet</servlet-name>
        <servlet-class>za.ac.tut.web.StartSessionServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>za.ac.tut.web.LogoutServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AnalyzeMessageServlet</servlet-name>
        <servlet-class>za.ac.tut.web.AnalyzeMessageServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>SearchMessageServlet</servlet-name>
        <servlet-class>za.ac.tut.web.SearchMessageServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>GetTotCriticalServlet</servlet-name>
        <servlet-class>za.ac.tut.web.GetTotCriticalServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>GetMessagesPerClassServlet</servlet-name>
        <servlet-class>za.ac.tut.web.GetMessagesPerClassServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>GetAgentWithMostReportsPerClassServlet</servlet-name>
        <servlet-class>za.ac.tut.web.GetAgentWithMostReportsPerClassServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StartSessionServlet</servlet-name>
        <url-pattern>/StartSessionServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/LogoutServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AnalyzeMessageServlet</servlet-name>
        <url-pattern>/AnalyzeMessageServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SearchMessageServlet</servlet-name>
        <url-pattern>/SearchMessageServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>GetTotCriticalServlet</servlet-name>
        <url-pattern>/GetTotCriticalServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>GetMessagesPerClassServlet</servlet-name>
        <url-pattern>/GetMessagesPerClassServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>GetAgentWithMostReportsPerClassServlet</servlet-name>
        <url-pattern>/GetAgentWithMostReportsPerClassServlet.do</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
    <error-page>
        <error-code>403</error-code>
        <location>/unauthorized_access.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/file_not_found.jsp</location>
    </error-page>
    <error-page>
        <exception-type>za.ac.tut.model.exception.InvalidDataException</exception-type>
        <location>/invalid_data_exception.jsp</location>
    </error-page>
    <context-param>
        <param-name>Comp</param-name>
        <param-value>Siri</param-value>
    </context-param>
    <security-constraint>
        <display-name>AgentConstraint</display-name>
        <web-resource-collection>
            <web-resource-name>AgentResources</web-resource-name>
            <description>These are the resources are available to the agent</description>
            <url-pattern>/field_agent.html</url-pattern>
            <url-pattern>/field_agent_menu.jsp</url-pattern>
            <url-pattern>/StartSessionServlet.do</url-pattern>
            <url-pattern>/field_agent_menu2.jsp</url-pattern>
            <url-pattern>/enter_message.jsp</url-pattern>
            <url-pattern>/AnalyzeMessageServlet.do</url-pattern>
            <url-pattern>/enter_message_outcome.jsp</url-pattern>
            <url-pattern>/search_message.jsp</url-pattern>
            <url-pattern>/SearchMessageServlet.do</url-pattern>
            <url-pattern>/search_message_outcome.jsp</url-pattern>
            <url-pattern>/GetTotCriticalServlet.do</url-pattern>
            <url-pattern>/get_tot_critical_outcome.jsp</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <description/>
            <role-name>agent</role-name>
        </auth-constraint>
    </security-constraint>
    <security-constraint>
        <display-name>ManagerConstraint</display-name>
        <web-resource-collection>
            <web-resource-name>ManagerResource</web-resource-name>
            <description>These are the resources available to the manager</description>
            <url-pattern>/manager.html</url-pattern>
            <url-pattern>/get_agent_with_most_reports_messages_per_class.jsp</url-pattern>
            <url-pattern>/get_agent_with_most_reports_per_class_outcome.jsp</url-pattern>
            <url-pattern>/get_messages_per_class.jsp</url-pattern>
            <url-pattern>/get_messages_per_class_outcome.jsp</url-pattern>
            <url-pattern>/GetMessagesPerClassServlet.do</url-pattern>
            <url-pattern>/GetAgentWithMostReportsPerClassServlet.do</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <description/>
            <role-name>manager</role-name>
        </auth-constraint>
    </security-constraint>
    <login-config>
        <auth-method>FORM</auth-method>
        <realm-name>file</realm-name>
        <form-login-config>
            <form-login-page>/login.jsp</form-login-page>
            <form-error-page>/login_error.jsp</form-error-page>
        </form-login-config>
    </login-config>
    <security-role>
        <description>The agent role is responisble for adding an agent, enter a message, search for a message and view the total number of critical priority messages</description>
        <role-name>agent</role-name>
    </security-role>
    <security-role>
        <description>The manager role is responsible for viewing messages according to specified classification and view agent with the most resports according to specified classification</description>
        <role-name>manager</role-name>
    </security-role>
</web-app>
