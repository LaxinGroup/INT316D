<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <servlet>
        <servlet-name>SetTestServlet</servlet-name>
        <servlet-class>za.ac.tut.web.SetTestServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>PassedServlet</servlet-name>
        <servlet-class>za.ac.tut.web.PassedServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>TopLearnerServlet</servlet-name>
        <servlet-class>za.ac.tut.web.TopLearnerServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AddLearnerServlet</servlet-name>
        <servlet-class>za.ac.tut.web.AddLearnerServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>TakeTestServlet</servlet-name>
        <servlet-class>za.ac.tut.web.TakeTestServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>za.ac.tut.web.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SetTestServlet</servlet-name>
        <url-pattern>/SetTestServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PassedServlet</servlet-name>
        <url-pattern>/PassedServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>TopLearnerServlet</servlet-name>
        <url-pattern>/TopLearnerServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AddLearnerServlet</servlet-name>
        <url-pattern>/AddLearnerServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>TakeTestServlet</servlet-name>
        <url-pattern>/TakeTestServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/LogoutServlet.do</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
    <error-page>
        <error-code>404</error-code>
        <location>/file_not_found.jsp</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/unauthorized_access.jsp</location>
    </error-page>
    <error-page>
        <exception-type>za.ac.tut.model.exception.InvalidDataException</exception-type>
        <location>/invalid_data_exception.jsp</location>
    </error-page>
    <error-page>
        <exception-type>za.ac.tut.model.exception.EmptyDataException</exception-type>
        <location>/empty_data_exception.jsp</location>
    </error-page>
    <security-constraint>
        <display-name>TeacherConstraint</display-name>
        <web-resource-collection>
            <web-resource-name>TeacherResource</web-resource-name>
            <description>These are the resources available to the teacher</description>
            <url-pattern>/teacher.html</url-pattern>
            <url-pattern>/SetTestServlet.do</url-pattern>
            <url-pattern>/PassedServlet.do</url-pattern>
            <url-pattern>/TopLearnerServlet.do</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <description/>
            <role-name>teacher</role-name>
        </auth-constraint>
    </security-constraint>
    <security-constraint>
        <display-name>LearnerConstraint</display-name>
        <web-resource-collection>
            <web-resource-name>LearnerResource</web-resource-name>
            <description>These are the resources available to the learner</description>
            <url-pattern>/learner.html</url-pattern>
            <url-pattern>/AddLearnerServlet.do</url-pattern>
            <url-pattern>/TakeTestServlet.do</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <description/>
            <role-name>learner</role-name>
        </auth-constraint>
    </security-constraint>
    <login-config>
        <auth-method>FORM</auth-method>
        <realm-name>file</realm-name>
        <form-login-config>
            <form-login-page>/login.jsp</form-login-page>
            <form-error-page>/login_error.jsp</form-error-page>
        </form-login-config>
    </login-config>
    <security-role>
        <description>The teacher role is allowed to set a test, view learners who passed and view the top learner</description>
        <role-name>teacher</role-name>
    </security-role>
    <security-role>
        <description>The learner role is allowed to take a test</description>
        <role-name>learner</role-name>
    </security-role>
</web-app>
